generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Permission {
  key    String           @id
  nameAr String
  roles  RolePermission[]
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  nameAr      String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId        Int
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model User {
  id           Int                   @id @default(autoincrement())
  username     String                @unique
  fullName     String
  passwordHash String
  phone        String?
  roleId       Int
  isActive     Boolean               @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  expenses     Expense[]
  movements    InventoryMovement[]
  payments     Payment[]
  purchases    Purchase[]
  returns      Return[]
  sales        Sale[]
  sessions     Session[]
  treasuryTxs  TreasuryTransaction[]
  role         Role                  @relation(fields: [roleId], references: [id])

  @@index([roleId])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id             Int                 @id @default(autoincrement())
  name           String
  sku            String?             @unique
  barcode        String?             @unique
  type           String              @default("ACCESSORY")
  categoryId     Int?
  brandId        Int?
  storageGb      Int?
  ramGb          Int?
  color          String?
  purchasePrice  Int                 @default(0)
  sellingPrice   Int                 @default(0)
  quantity       Int                 @default(0)
  minStock       Int                 @default(3)
  warrantyMonths Int?
  notes          String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  movements      InventoryMovement[]
  phoneUnits     PhoneUnit[]
  brand          Brand?              @relation(fields: [brandId], references: [id])
  category       Category?           @relation(fields: [categoryId], references: [id])
  purchaseItems  PurchaseItem[]
  returnItems    ReturnItem[]
  saleItems      SaleItem[]

  @@index([name])
  @@index([type])
  @@index([categoryId])
  @@index([brandId])
}

model PhoneUnit {
  id             Int       @id @default(autoincrement())
  productId      Int
  imei1          String    @unique
  imei2          String?
  serialNumber   String?   @unique
  status         String    @default("IN_STOCK")
  purchasePrice  Int?
  sellingPrice   Int?
  warrantyMonths Int?
  purchaseItemId Int?
  saleItemId     Int?
  soldAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@index([saleItemId])
  @@index([purchaseItemId])
}

model InventoryMovement {
  id             Int      @id @default(autoincrement())
  productId      Int
  type           String
  quantityChange Int
  balanceAfter   Int
  referenceType  String?
  referenceId    Int?
  note           String?
  userId         Int?
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
  returns   Return[]
  sales     Sale[]

  @@index([name])
  @@index([phone])
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  payments  Payment[]
  purchases Purchase[]
  returns   Return[]

  @@index([name])
  @@index([phone])
}

model Sale {
  id             Int        @id @default(autoincrement())
  invoiceNumber  String     @unique
  customerId     Int?
  userId         Int
  subtotal       Int        @default(0)
  discount       Int        @default(0)
  total          Int        @default(0)
  paidAmount     Int        @default(0)
  returnedAmount Int        @default(0)
  status         String     @default("COMPLETED")
  paymentMethod  String     @default("CASH")
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  taxRate        Float      @default(0)
  taxAmount      Int        @default(0)
  payments       Payment[]
  returns        Return[]
  customer       Customer?  @relation(fields: [customerId], references: [id])
  user           User       @relation(fields: [userId], references: [id])
  items          SaleItem[]

  @@index([createdAt])
  @@index([customerId])
  @@index([userId])
  @@index([status])
}

model SaleItem {
  id               Int     @id @default(autoincrement())
  saleId           Int
  productId        Int
  productName      String
  quantity         Int
  unitPrice        Int
  unitCost         Int
  discount         Int     @default(0)
  lineTotal        Int
  lineCost         Int
  returnedQuantity Int     @default(0)
  product          Product @relation(fields: [productId], references: [id])
  sale             Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model Purchase {
  id             Int            @id @default(autoincrement())
  invoiceNumber  String         @unique
  supplierId     Int
  userId         Int
  subtotal       Int            @default(0)
  discount       Int            @default(0)
  total          Int            @default(0)
  paidAmount     Int            @default(0)
  returnedAmount Int            @default(0)
  status         String         @default("COMPLETED")
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  taxRate        Float          @default(0)
  taxAmount      Int            @default(0)
  payments       Payment[]
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  items          PurchaseItem[]
  returns        Return[]

  @@index([createdAt])
  @@index([supplierId])
}

model PurchaseItem {
  id               Int      @id @default(autoincrement())
  purchaseId       Int
  productId        Int
  productName      String
  quantity         Int
  unitCost         Int
  lineTotal        Int
  returnedQuantity Int      @default(0)
  product          Product  @relation(fields: [productId], references: [id])
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model Payment {
  id         Int       @id @default(autoincrement())
  kind       String
  saleId     Int?
  purchaseId Int?
  customerId Int?
  supplierId Int?
  amount     Int
  method     String    @default("CASH")
  treasuryId Int?
  note       String?
  userId     Int
  createdAt  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id])
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([saleId])
  @@index([purchaseId])
  @@index([customerId])
  @@index([supplierId])
  @@index([createdAt])
}

model ExpenseCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  isSystem Boolean   @default(false)
  expenses Expense[]
}

model Expense {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  amount      Int
  description String?
  method      String          @default("CASH")
  treasuryId  Int?
  userId      Int
  createdAt   DateTime        @default(now())
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([categoryId])
  @@index([createdAt])
}

model TreasuryTransaction {
  id            Int      @id @default(autoincrement())
  direction     String
  type          String
  amount        Int
  method        String   @default("CASH")
  referenceType String?
  referenceId   Int?
  note          String?
  userId        Int
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
}

model Return {
  id            Int          @id @default(autoincrement())
  invoiceNumber String       @unique
  type          String
  saleId        Int?
  purchaseId    Int?
  customerId    Int?
  supplierId    Int?
  userId        Int
  total         Int          @default(0)
  refundMethod  String       @default("CASH")
  restock       Boolean      @default(true)
  reason        String?
  createdAt     DateTime     @default(now())
  customer      Customer?    @relation(fields: [customerId], references: [id])
  purchase      Purchase?    @relation(fields: [purchaseId], references: [id])
  sale          Sale?        @relation(fields: [saleId], references: [id])
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  items         ReturnItem[]

  @@index([createdAt])
  @@index([saleId])
  @@index([purchaseId])
}

model ReturnItem {
  id             Int     @id @default(autoincrement())
  returnId       Int
  saleItemId     Int?
  purchaseItemId Int?
  productId      Int
  productName    String
  quantity       Int
  unitPrice      Int
  lineTotal      Int
  product        Product @relation(fields: [productId], references: [id])
  return         Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

model Counter {
  name  String @id
  value Int    @default(0)
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  username  String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}
