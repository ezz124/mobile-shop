{
  "name": "mbile-erp",
  "productName": "متجر موبايل - نظام الإدارة",
  "version": "1.0.0",
  "description": "نظام ويب لإدارة متاجر الهواتف النقّالة",
  "author": "Mbile ERP",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently --kill-others-on-fail -n api,vite -c magenta,green \"npm run server\" \"vite\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run web:build",
    "start": "npm run web:start",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "web:build": "vite build && tsc -p server/tsconfig.json",
    "web:start": "npm run web:build && node server-dist/server/index.js",
    "server": "tsx watch --tsconfig server/tsconfig.json server/index.ts"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.1.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.59.20",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^11.11.17",
    "helmet": "^8.3.0",
    "lucide-react": "^0.454.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.13.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
